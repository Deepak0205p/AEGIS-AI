# Signs session tokens.
AEGIS_JWT_SECRET=generate-a-strong-random-secret-key-here-for-production

# CORS allowed browser origins (comma-separated)
AEGIS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Database Driver: postgres or mysql
AEGIS_DB_DRIVER=mysql

# MySQL / MariaDB (XAMPP / local)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=sih_sovereign_ai

# PostgreSQL (Alternative)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=sih_sovereign_ai
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sih_sovereign_ai?schema=public

# Database connect timeout in seconds
AEGIS_DB_CONNECT_TIMEOUT=5

# Models & Inference
MODEL_NAME=deepseek-v4-pro:4b
VISION_MODEL_NAME=qwen2.5vl:3b
OCR_MODEL_NAME=unlimited-ocr:latest
OLLAMA_HOST=http://localhost:11434
NUM_CTX=8192
OLLAMA_TIMEOUT=60.0
