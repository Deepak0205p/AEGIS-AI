# ====================================================================
# AIR-GAPPED PYTHON RUNTIME SANDBOX CONTAINER
# Image Tag: python-sandbox:latest
# Security: Non-root user (uid 1000), Air-gapped (no network access),
#           Pre-installed data science & industrial calculation packages.
# ====================================================================

FROM python:3.11-slim

# Create dedicated unprivileged sandbox user
RUN groupadd -g 1000 sandbox && \
    useradd -u 1000 -g sandbox -m -s /bin/bash sandbox

# Install standard computational & data manipulation libraries
RUN pip install --no-cache-dir \
    numpy \
    pandas \
    openpyxl \
    matplotlib \
    scipy \
    requests

# Working directory for air-gapped script execution
WORKDIR /task
RUN chown -R sandbox:sandbox /task

USER sandbox

CMD ["python", "main.py"]
