{
  "name": "mrpl-sovereign-workbench",
  "version": "1.0.0",
  "description": "On-premise air-gapped agentic AI workbench: FastAPI + Next.js + PostgreSQL",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:verify": "node scripts/prisma-verify.mjs",
    "prisma:check": "node scripts/prisma-check.mjs",
    "prisma:schema": "node scripts/prisma-verify.mjs --print",
    "prisma:reset": "prisma db push --force-reset"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "prisma": "^5.19.1"
  },
  "engines": {
    "node": ">=18"
  }
}
